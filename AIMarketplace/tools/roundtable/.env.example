# Copy this file to .env and paste your keys (NEVER commit .env — .gitignore
# blocks it). Each LLM key powers one panelist. ELEVENLABS_API_KEY is the
# voice renderer; if you omit it the script falls back to OpenAI TTS.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# Voice renderer (recommended — much better quality than OpenAI TTS).
# Get from elevenlabs.io → Profile → API Keys.
ELEVENLABS_API_KEY=
