// Copy this file to Secrets.xcconfig (in the same directory), fill in the
// production values, then `xcodegen generate`. Secrets.xcconfig is in
// .gitignore so the real values never get committed.
//
// AIMKT_SHARED_SECRET must EXACTLY match the value of `APP_SHARED_SECRET`
// set on your Worker via:  npx wrangler secret put APP_SHARED_SECRET
//
// Generate a fresh one with:  openssl rand -base64 48

AIMKT_WORKER_URL = https:/$()/aimarketplace-payout.YOUR-SUBDOMAIN.workers.dev
AIMKT_SHARED_SECRET = REPLACE_WITH_THE_SHARED_SECRET_YOU_PASTED_TO_WRANGLER
