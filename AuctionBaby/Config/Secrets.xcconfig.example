// Secrets.xcconfig.example — template for the untracked Config/Secrets.xcconfig.
//
// Copy this file to Config/Secrets.xcconfig (same directory) and fill the
// two values in. Secrets.xcconfig is git-ignored, so real values never leak.
// Build.xcconfig `#include?`s it, and Info.plist substitutes `$(AB_WORKER_URL)`
// / `$(AB_SHARED_SECRET)` at build time so BackendConfig can read them from
// the app bundle at runtime.
//
// Absence is fine: without Secrets.xcconfig the app still compiles; the
// admin console just shows the Worker as unconfigured until it's provisioned.
//
//   npx wrangler deploy                     # in backend/
//   npx wrangler secret put APP_SHARED_SECRET   # long random string
//   # paste the same string into AB_SHARED_SECRET below
//   # paste the deployed workers.dev URL into AB_WORKER_URL below

// xcconfig treats // as a comment. The empty $() expansion preserves the
// second slash; writing a literal https:// value silently compiles as https:.
AB_WORKER_URL = https:/$()/auctionbaby-payout.YOUR-SUBDOMAIN.workers.dev
AB_SHARED_SECRET = replace-me-with-a-long-random-string
// Optional — the Stripe web Gavel shop (consumables/ Worker). Leave blank
// to disable the web-balance sync; the app works fine without it.
AB_CONSUMABLES_URL = https:/$()/auctionbaby-consumables.YOUR-SUBDOMAIN.workers.dev
// Optional — the auth Worker (Sign in with Apple → server user identity).
// Slice 1 of the spine; see SPINE_ROADMAP.md. Leave blank to keep the app
// local-only (which is also what Demo Mode uses).
AB_AUTH_URL = https:/$()/auctionbaby-auth.YOUR-SUBDOMAIN.workers.dev
// Optional — the matching Worker (real bids/matches/messages between
// signed-in users). Slice 4 of the spine. Leave blank → app uses its
// on-device simulation for those flows.
AB_MATCHING_URL = https:/$()/auctionbaby-matching.YOUR-SUBDOMAIN.workers.dev

// Public URLs for Terms of Service + Privacy Policy. App Store 5.1.1
// requires both to be linked from within the app for any account-
// creation flow. Set these to your hosted HTML pages before submission —
// the app's fallback URLs are only a development safety net.
AB_TERMS_URL = https:/$()/mvalasek77-droid.github.io/Mike_claw/auctionbaby/terms.html
AB_PRIVACY_URL = https:/$()/mvalasek77-droid.github.io/Mike_claw/auctionbaby/privacy.html
