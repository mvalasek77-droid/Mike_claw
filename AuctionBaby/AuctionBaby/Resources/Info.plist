<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Auction Baby</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>AuctionBaby</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>5</string>
	<key>AB_WORKER_URL</key>
	<string>$(AB_WORKER_URL)</string>
	<key>AB_SHARED_SECRET</key>
	<string>$(AB_SHARED_SECRET)</string>
	<key>AB_CONSUMABLES_URL</key>
	<string>$(AB_CONSUMABLES_URL)</string>
	<key>AB_AUTH_URL</key>
	<string>$(AB_AUTH_URL)</string>
	<key>AB_MATCHING_URL</key>
	<string>$(AB_MATCHING_URL)</string>
	<key>AB_TERMS_URL</key>
	<string>$(AB_TERMS_URL)</string>
	<key>AB_PRIVACY_URL</key>
	<string>$(AB_PRIVACY_URL)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Auction Baby needs access to your photos so you can upload the pictures that appear on your profile. Photos never leave your device without your action.</string>
	<key>NSCameraUsageDescription</key>
	<string>Auction Baby uses the camera for identity verification — a live selfie is matched to your profile photos so the blue check on your profile means you're a real person, not a copycat.</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.social-networking</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
