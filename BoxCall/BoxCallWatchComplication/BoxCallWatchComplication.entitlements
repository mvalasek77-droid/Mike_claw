<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Same group id as the watch app target. The complication extension
	  runs in its own process; without this entitlement its
	  UserDefaults(suiteName:) misses the watch app's cache and the
	  complication renders the placeholder forever.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.boxcall.shared</string>
	</array>
</dict>
</plist>